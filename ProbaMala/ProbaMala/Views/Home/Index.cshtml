@using ProbaMala.Models.Entities
@model ProbaMala.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mx-auto w-full max-w-3xl space-y-4 px-4 sm:px-6">

    @* ── Stats bar: 4 chips in a panel ── *@
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">
        <div class="grid grid-cols-4 divide-x divide-slate-800">

            <div class="flex flex-col items-center gap-0.5 px-4 py-4">
                <span class="text-xl font-bold tabular-nums text-slate-100">@Model.TotalClubs</span>
                <span class="text-xs font-semibold uppercase tracking-widest text-slate-500">Clubs</span>
            </div>

            <div class="flex flex-col items-center gap-0.5 px-4 py-4">
                <span class="text-xl font-bold tabular-nums text-slate-100">@Model.TotalPlayers</span>
                <span class="text-xs font-semibold uppercase tracking-widest text-slate-500">Players</span>
            </div>

            <div class="flex flex-col items-center gap-0.5 px-4 py-4">
                <span class="text-xl font-bold tabular-nums text-slate-100">@Model.TotalMatches</span>
                <span class="text-xs font-semibold uppercase tracking-widest text-slate-500">Matches</span>
            </div>

            <div class="flex flex-col items-center gap-0.5 px-4 py-4">
                <span class="text-xl font-bold tabular-nums text-lime-400">@Model.AverageRating</span>
                <span class="text-xs font-semibold uppercase tracking-widest text-slate-500">Avg Rating</span>
            </div>

        </div>
    </div>

    @* ── Recent Matches panel ── *@
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

        <div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
            <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Recent Matches</span>
            <a asp-route="matches-index" class="text-xs font-semibold text-lime-400 transition hover:text-lime-300">View all</a>
        </div>

        @* Column headers *@
        <div class="grid grid-cols-[5rem_1fr_auto_1fr_5rem] border-b border-slate-800/60 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-slate-600">
            <span>Date</span>
            <span class="text-right">Home</span>
            <span class="px-3 text-center">Score</span>
            <span>Away</span>
            <span class="text-center">Rtg</span>
        </div>

        @if (!Model.RecentMatches.Any())
        {
            <div class="px-4 py-8 text-center text-sm text-slate-500">No recent matches.</div>
        }
        else
        {
            @foreach (var match in Model.RecentMatches)
            {
                @* Status tone color *@
                var statusColor = match.StatusTone switch
                {
                    "live"     => "text-lime-400",
                    "finished" => "text-slate-500",
                    _          => "text-slate-400"
                };

                <div class="group grid cursor-pointer grid-cols-[5rem_1fr_auto_1fr_5rem] items-center border-b border-slate-800/40 px-4 py-3 last:border-b-0 transition hover:bg-white/[0.03]"
                     data-row-href="@Url.RouteUrl("match-details", new { id = match.MatchId })">

                    @* Date + status *@
                    <div class="flex flex-col">
                        <span class="text-xs text-slate-500">@match.KickoffLabel</span>
                        <span class="text-xs font-medium @statusColor">@match.StatusLabel</span>
                    </div>

                    @* Home team (right-aligned) *@
                    <div class="flex items-center justify-end">
                        <a asp-route="club-details" asp-route-id="@match.HomeTeamId"
                           class="truncate text-sm font-medium text-slate-100 transition hover:text-lime-400">@match.HomeTeamName</a>
                    </div>

                    @* Score badge *@
                    <div class="px-3">
                        <a asp-route="match-details" asp-route-id="@match.MatchId"
                           class="inline-flex min-w-[3.5rem] items-center justify-center rounded bg-slate-800 px-2 py-1 text-sm font-bold tabular-nums text-slate-100 transition hover:bg-slate-700">
                            @match.HomeGoals – @match.AwayGoals
                        </a>
                    </div>

                    @* Away team (left-aligned) *@
                    <div class="flex items-center">
                        <a asp-route="club-details" asp-route-id="@match.AwayTeamId"
                           class="truncate text-sm font-medium text-slate-100 transition hover:text-lime-400">@match.AwayTeamName</a>
                    </div>

                    @* Ratings count *@
                    <span class="text-center text-xs text-slate-500">@match.RatingCount</span>
                </div>
            }
        }
    </div>

    @* ── Two side-by-side panels: Top Players + Club Form ── *@
    <div class="grid grid-cols-1 gap-4 xl:grid-cols-2">

        @* Top Players panel *@
        <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

            <div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
                <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Top Players</span>
                <a asp-route="players-index" class="text-xs font-semibold text-lime-400 transition hover:text-lime-300">View all</a>
            </div>

            @if (!Model.FeaturedPlayers.Any())
            {
                <div class="px-4 py-8 text-center text-sm text-slate-500">No player data.</div>
            }
            else
            {
                @foreach (var fp in Model.FeaturedPlayers)
                {
                    @* Position badge color *@
                    var posBadge = fp.Position switch
                    {
                        Position.Goalkeeper => "text-indigo-400 bg-indigo-500/10",
                        Position.Defender   => "text-emerald-400 bg-emerald-500/10",
                        Position.Midfielder => "text-amber-400 bg-amber-500/10",
                        Position.Forward    => "text-rose-400 bg-rose-500/10",
                        _                   => "text-slate-400 bg-slate-500/10"
                    };

                    <div class="flex items-center justify-between border-b border-slate-800/40 px-4 py-3 last:border-b-0 transition hover:bg-white/[0.03]">
                        <div class="flex min-w-0 flex-col gap-0.5">
                            <a asp-route="player-details" asp-route-id="@fp.PlayerId"
                               class="truncate text-sm font-medium text-slate-100 hover:text-lime-400 transition">
                                @fp.FullName
                            </a>
                            <div class="flex items-center gap-1.5">
                                <span class="rounded px-1.5 py-0.5 text-xs font-medium @posBadge">@fp.Position.ToString()</span>
                                <span class="truncate text-xs text-slate-500">@(fp.ClubName ?? "—")</span>
                            </div>
                        </div>
                        @* Average rating chip *@
                        <span class="ml-3 shrink-0 rounded bg-lime-500/10 px-2 py-1 text-xs font-bold text-lime-400">
                            @fp.AverageRating
                        </span>
                    </div>
                }
            }
        </div>

        @* Club Form panel *@
        <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

            <div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
                <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Club Form</span>
                <a asp-route="clubs-index" class="text-xs font-semibold text-lime-400 transition hover:text-lime-300">View all</a>
            </div>

            @if (!Model.ClubForms.Any())
            {
                <div class="px-4 py-8 text-center text-sm text-slate-500">No form data.</div>
            }
            else
            {
                @foreach (var cf in Model.ClubForms)
                {
                    <div class="flex items-center justify-between border-b border-slate-800/40 px-4 py-3 last:border-b-0 transition hover:bg-white/[0.03]">
                        <a asp-route="club-details" asp-route-id="@cf.ClubId"
                           class="truncate text-sm font-medium text-slate-100 transition hover:text-lime-400">@cf.ClubName</a>

                        @* W/D/L result chips *@
                        <div class="flex shrink-0 items-center gap-1 ml-3">
                            @foreach (var result in cf.Results)
                            {
                                var chipClass = result switch
                                {
                                    "W" => "bg-emerald-500/15 text-emerald-300",
                                    "D" => "bg-amber-500/15 text-amber-300",
                                    "L" => "bg-rose-500/15 text-rose-300",
                                    _   => "bg-slate-500/15 text-slate-400"
                                };
                                <span class="inline-flex h-6 w-6 items-center justify-center rounded text-xs font-bold @chipClass">
                                    @result
                                </span>
                            }
                        </div>
                    </div>
                }
            }
        </div>

    </div>

</div>
