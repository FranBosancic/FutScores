@model UserFormViewModel

@{
    ViewData["Title"] = "Edit User";
}

<div class="mx-auto w-full max-w-3xl space-y-4 px-4 sm:px-6">

    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

        @* Title bar *@
        <div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="h-4 w-1 shrink-0 rounded-full bg-lime-500 opacity-70"></span>
                <span class="text-sm font-semibold text-slate-100">Edit user</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-500">
                <a asp-route="users-index" class="transition hover:text-slate-300">All users</a>
                <span>/</span>
                <a asp-route="user-details" asp-route-id="@Model.Id" class="transition hover:text-slate-300">Details</a>
                <span>/</span>
                <span class="text-slate-400">Edit</span>
            </div>
        </div>

        @* Body *@
        <div class="px-4 py-5">
            <p class="mb-5 text-sm text-slate-400">Update the identity details used throughout the rating workflow.</p>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-6">
                @Html.AntiForgeryToken()
                <partial name="_UserForm" model="Model" />

                <div class="flex flex-wrap items-center gap-3 border-t border-slate-800/60 pt-5">
                    <button type="submit" class="inline-flex items-center rounded-lg bg-lime-500 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-lime-400">Save changes</button>
                    <a asp-route="user-details" asp-route-id="@Model.Id" class="inline-flex items-center rounded-lg border border-slate-700 px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-slate-100">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
