@model List<ProbaMala.Models.ViewModels.UserDetailsViewModel>

@* Section header with Add User button *@
<div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
    <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Users</span>
    <a asp-route="user-create" class="flex items-center gap-1 text-xs font-semibold text-lime-400 transition hover:text-lime-300">
        <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        Add user
    </a>
</div>

@* Column headers *@
<div class="grid grid-cols-[1fr_1fr_5rem_4rem] border-b border-slate-800/60 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-slate-600">
    <span>Name</span>
    <span>Email</span>
    <span class="text-center">Ratings</span>
    <span></span>
</div>

@if (!Model.Any())
{
    <div class="px-4 py-8 text-center text-sm text-slate-500">No users found.</div>
}
else
{
    @foreach (var user in Model)
    {
        <div class="group grid cursor-pointer grid-cols-[1fr_1fr_5rem_4rem] items-center border-b border-slate-800/40 px-4 py-3 last:border-b-0 transition hover:bg-white/[0.03]"
             data-row-href="@Url.RouteUrl("user-details", new { id = user.Id })">

            @* Name with lime pill *@
            <div class="flex min-w-0 items-center gap-2">
                <span class="h-4 w-1 shrink-0 rounded-full bg-lime-500 opacity-70"></span>
                <a asp-route="user-details" asp-route-id="@user.Id"
                   class="truncate text-sm font-medium text-slate-100 hover:text-lime-400 transition">
                    @($"{user.FirstName} {user.LastName}")
                </a>
            </div>

            @* Email *@
            <span class="truncate text-sm text-slate-400">@user.Email</span>

            @* Ratings count *@
            <span class="text-center text-sm text-slate-400">@user.RatingCount</span>

            @* Edit / Delete — fade in on hover *@
            <div class="flex items-center justify-end gap-1 opacity-0 transition group-hover:opacity-100">
                <a asp-route="user-edit" asp-route-id="@user.Id"
                   title="Edit"
                   class="rounded p-1 text-slate-400 transition hover:bg-slate-700 hover:text-slate-100">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" />
                    </svg>
                </a>
                <a asp-route="user-delete" asp-route-id="@user.Id"
                   title="Delete"
                   class="rounded p-1 text-slate-400 transition hover:bg-rose-500/10 hover:text-rose-400">
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" />
                    </svg>
                </a>
            </div>
        </div>
    }
}
