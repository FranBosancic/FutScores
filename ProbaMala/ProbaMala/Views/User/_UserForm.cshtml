@model UserFormViewModel

<div asp-validation-summary="ModelOnly" class="mb-5 rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200"></div>

<input asp-for="Id" type="hidden" />

<div class="grid gap-6 lg:grid-cols-2">
    <div>
        <label asp-for="FirstName" class="mb-2 block text-sm font-medium text-slate-200"></label>
        <input asp-for="FirstName" class="w-full rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2.5 text-sm text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-lime-500/60 focus:bg-slate-800" />
        <span asp-validation-for="FirstName" class="mt-2 block text-sm text-rose-300"></span>
    </div>

    <div>
        <label asp-for="LastName" class="mb-2 block text-sm font-medium text-slate-200"></label>
        <input asp-for="LastName" class="w-full rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2.5 text-sm text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-lime-500/60 focus:bg-slate-800" />
        <span asp-validation-for="LastName" class="mt-2 block text-sm text-rose-300"></span>
    </div>

    <div class="lg:col-span-2">
        <label asp-for="Email" class="mb-2 block text-sm font-medium text-slate-200"></label>
        <input asp-for="Email" class="w-full rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2.5 text-sm text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-lime-500/60 focus:bg-slate-800" />
        <span asp-validation-for="Email" class="mt-2 block text-sm text-rose-300"></span>
    </div>
</div>