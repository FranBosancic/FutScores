@using Microsoft.AspNetCore.Identity
@using ProbaMala.Models.Entities
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="flex min-w-0 items-center gap-2">
        @* Shows WHO you are logged in as (email/username) so identity is visible at a glance.
           Truncated so a long address can never stretch the header; full value in the tooltip.
           Clicking still opens your own ratings (edit/delete). *@
        <a asp-route="ratings-mine"
           title="Logged in as @User.Identity?.Name — open your ratings"
           class="flex min-w-0 shrink items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm text-slate-200 transition hover:bg-slate-800 hover:text-white">
            <svg class="h-4 w-4 shrink-0 text-slate-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
            <span class="max-w-[12rem] truncate font-medium">@User.Identity?.Name</span>
            @if (User.IsInRole("Admin"))
            {
                <span class="shrink-0 rounded bg-lime-500/15 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-lime-400">Admin</span>
            }
        </a>
        <form class="inline shrink-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.RouteUrl("home-index")" method="post">
            <button type="submit"
                    class="rounded-lg border border-slate-700 px-3 py-1.5 text-sm text-slate-300 transition hover:border-slate-600 hover:text-white">
                Log out
            </button>
        </form>
    </div>
}
else
{
    <div class="flex items-center gap-2">
        <a asp-area="Identity" asp-page="/Account/Login"
           class="rounded-lg px-3 py-1.5 text-sm text-slate-300 transition hover:text-white">
            Log in
        </a>
        <a asp-area="Identity" asp-page="/Account/Register"
           class="rounded-lg bg-lime-500 px-3 py-1.5 text-sm font-semibold text-slate-950 transition hover:bg-lime-400">
            Register
        </a>
    </div>
}
