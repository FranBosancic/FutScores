@using Microsoft.AspNetCore.Identity
@using ProbaMala.Models.Entities
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="flex items-center gap-3">
        <span class="hidden text-xs text-slate-400 lg:inline">
            @User.Identity?.Name
            @if (User.IsInRole("Admin"))
            {
                <span class="ml-1 rounded bg-lime-500/15 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-lime-400">Admin</span>
            }
        </span>
        <form class="inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.RouteUrl("home-index")" method="post">
            <button type="submit"
                    class="rounded-lg border border-slate-700 px-3 py-1.5 text-sm text-slate-300 transition hover:border-slate-600 hover:text-white">
                Log out
            </button>
        </form>
    </div>
}
else
{
    <div class="flex items-center gap-2">
        <a asp-area="Identity" asp-page="/Account/Login"
           class="rounded-lg px-3 py-1.5 text-sm text-slate-300 transition hover:text-white">
            Log in
        </a>
        <a asp-area="Identity" asp-page="/Account/Register"
           class="rounded-lg bg-lime-500 px-3 py-1.5 text-sm font-semibold text-slate-950 transition hover:bg-lime-400">
            Register
        </a>
    </div>
}
