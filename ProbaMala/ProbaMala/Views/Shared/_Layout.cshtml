@using ProbaMala.Repositories
@inject ILeagueRepository LeagueRepo

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString();

    // Fetch all leagues once and reuse for both desktop and mobile nav.
    // Ordered alphabetically; the list is typically short so no paging needed.
    var navLeagues = LeagueRepo.GetAll();

    // Helper: returns the Tailwind active-link classes when the condition is true.
    string ActiveClass(bool active) =>
        active ? "text-white border-b-2 border-lime-500 pb-1" : "";

    // Mobile menu variant: a filled highlight reads better than an underline in a stacked list.
    string MobileActiveClass(bool active) =>
        active ? "bg-slate-800 font-medium text-white" : "text-slate-200 hover:bg-slate-900";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FutScores</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tailwind.generated.css" asp-append-version="true" />
    @* flatpickr base stylesheet — required for the date pickers to position/hide correctly.
       Must load BEFORE site.css so our custom flatpickr theme overrides win. Without this,
       the calendar renders full-size in normal flow and inflates the page (footer stranded). *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProbaMala.styles.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen flex-col bg-[#02040d] font-['Inter'] text-slate-100">

    <header class="sticky top-0 z-30 border-b border-slate-800 bg-[#070b13]/95 backdrop-blur-sm">
        <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-3 sm:px-6">

            @* ── Brand logo ── *@
            <a asp-route="home-index" class="flex shrink-0 items-center gap-3 text-white">
                <span class="flex h-10 w-10 items-center justify-center rounded bg-lime-500 text-base font-semibold text-slate-950">FS</span>
                <div class="leading-tight">
                    <div class="text-base font-semibold">FutScores</div>
                    <div class="text-xs text-slate-400">Football dashboard</div>
                </div>
            </a>

            @* ── Global search (desktop) ── *@
            @* Hidden until xl so it doesn't eat horizontal space at lg where the nav first
               appears; the hamburger menu carries its own search on smaller screens. *@
            <div class="relative hidden xl:block" data-global-search>
                <input type="search"
                       data-global-search-input
                       placeholder="Search pages…"
                       autocomplete="off"
                       aria-label="Search pages"
                       class="w-44 rounded-lg border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-lime-500/60 focus:bg-slate-900 lg:w-56" />
                <div data-global-search-results
                     class="absolute left-0 top-full z-50 mt-1 hidden w-72 overflow-hidden rounded-xl border border-white/10 bg-[#070b13] shadow-2xl"></div>
            </div>

            @* ── Desktop navigation ── *@
            @* Shows from lg up. Every league lives inside ONE "Leagues" dropdown so the row
               keeps a fixed, small item count and fits a normal laptop width at 100% zoom
               without overflowing into a horizontal scrollbar. Below lg → hamburger menu. *@
            <nav class="hidden flex-1 items-center gap-5 text-sm lg:flex">

                @* Dashboard — always the first static link *@
                <a asp-route="home-index"
                   class="transition hover:text-white @ActiveClass(currentController == "Home" && currentAction == "Index")">
                    Dashboard
                </a>

                @* Global section tabs — the cross-league lists *@
                <a asp-route="matches-index" class="transition hover:text-white @ActiveClass(currentController == "Match")">Matches</a>
                <a asp-route="players-index" class="transition hover:text-white @ActiveClass(currentController == "Player")">Players</a>
                <a asp-route="ratings-index" class="transition hover:text-white @ActiveClass(currentController == "Rating")">Ratings</a>
                <a asp-route="users-index" class="transition hover:text-white @ActiveClass(currentController == "User")">Users</a>

                @* Leagues — a single dropdown listing every league (previously each league was
                   its own top-level item, which needed a 1700px viewport to fit). *@
                @if (navLeagues.Any())
                {
                    <span class="h-4 w-px self-center bg-slate-700"></span>

                    @* after:content-[''] bridges the 12px gap to the panel so the hover
                       (group-hover) stays active while the mouse travels down. *@
                    <div class="group relative after:absolute after:inset-x-0 after:top-full after:h-3 after:content-['']">
                        <button type="button"
                                class="flex items-center gap-1 text-slate-300 transition hover:text-white @ActiveClass(currentController == "League")">
                            Leagues
                            <svg class="h-3 w-3 opacity-50 transition-transform duration-150 group-hover:rotate-180"
                                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd"
                                      d="M5.23 7.21a.75.75 0 011.06.02L10 11.085l3.71-3.755a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                                      clip-rule="evenodd" />
                            </svg>
                        </button>

                        @* Dropdown panel — scrolls internally if there are many leagues. *@
                        <div class="pointer-events-none invisible absolute left-0 top-full z-50 mt-0 max-h-80 w-48 overflow-y-auto
                                    rounded-xl border border-white/10 bg-[#070b13] py-1 opacity-0 shadow-2xl
                                    transition-all duration-150
                                    group-hover:pointer-events-auto group-hover:visible group-hover:opacity-100">
                            @foreach (var league in navLeagues)
                            {
                                <a href="/leagues/@league.Id"
                                   class="block px-4 py-2.5 text-sm text-slate-300 transition hover:bg-white/5 hover:text-white">
                                    @league.Name
                                </a>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <span class="text-sm italic text-slate-500">No leagues yet</span>
                }
            </nav>

            @* ── Auth (desktop only): login/register or user + logout ── *@
            <div class="hidden shrink-0 items-center lg:flex">
                <partial name="_LoginPartial" />
            </div>

            @* ── Mobile hamburger button ── *@
            <button id="mobile-menu-btn"
                    type="button"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                    aria-label="Toggle navigation menu"
                    class="ml-auto inline-flex h-10 w-10 shrink-0 flex-col items-center justify-center gap-1 rounded bg-slate-900 text-slate-200 transition hover:bg-slate-800 lg:hidden">
                <span class="h-0.5 w-5 rounded bg-current"></span>
                <span class="h-0.5 w-5 rounded bg-current"></span>
                <span class="h-0.5 w-5 rounded bg-current"></span>
            </button>
        </div>

        @*
            ── Mobile menu ──
            Since hover doesn't exist on touch devices, each league section
            shows its Clubs and Matches sub-links inline and indented.
        *@
        <div id="mobile-menu" class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-slate-800 bg-[#070b13]">
            <div class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-3 sm:px-6">

                @* ── Global search (mobile) ── *@
                <div class="relative mb-2" data-global-search>
                    <input type="search"
                           data-global-search-input
                           placeholder="Search pages…"
                           autocomplete="off"
                           aria-label="Search pages"
                           class="w-full rounded-lg border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-lime-500/60 focus:bg-slate-900" />
                    <div data-global-search-results
                         class="absolute left-0 top-full z-50 mt-1 hidden w-full overflow-hidden rounded-xl border border-white/10 bg-[#070b13] shadow-2xl"></div>
                </div>

                <a asp-route="home-index" class="rounded px-3 py-2 text-sm transition @MobileActiveClass(currentController == "Home" && currentAction == "Index")">
                    Dashboard
                </a>
                <a asp-route="matches-index" class="rounded px-3 py-2 text-sm transition @MobileActiveClass(currentController == "Match")">Matches</a>
                <a asp-route="players-index" class="rounded px-3 py-2 text-sm transition @MobileActiveClass(currentController == "Player")">Players</a>
                <a asp-route="ratings-index" class="rounded px-3 py-2 text-sm transition @MobileActiveClass(currentController == "Rating")">Ratings</a>
                <a asp-route="users-index" class="rounded px-3 py-2 text-sm transition @MobileActiveClass(currentController == "User")">Users</a>

                @foreach (var league in navLeagues)
                {
                    @* League heading *@
                    <div class="mt-2 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-slate-500">
                        @league.Name
                    </div>
                    @* Sub-links indented beneath the league name *@
                    <a href="/clubs?leagueId=@league.Id"
                       class="rounded py-1.5 pl-7 pr-3 text-sm text-slate-300 hover:bg-slate-900 hover:text-white">
                        Clubs
                    </a>
                    <a href="/matches?leagueId=@league.Id"
                       class="rounded py-1.5 pl-7 pr-3 text-sm text-slate-300 hover:bg-slate-900 hover:text-white">
                        Matches
                    </a>
                }

                @* Auth links/buttons for the mobile menu *@
                <div class="mt-3 border-t border-slate-800 px-3 pt-3">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </header>

    <main class="flex-1 py-8">
        @RenderBody()
    </main>

    <footer class="border-t border-slate-800 bg-[#070b13] text-slate-400">
        <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <div>
                <strong class="text-slate-100">FutScores</strong>
                <p class="text-sm text-slate-500">A cleaner football overview experience.</p>
            </div>
            <div class="text-sm">© 2026 FutScores</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/hr.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
