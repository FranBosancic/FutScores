@model List<ProbaMala.Models.ViewModels.SearchResultViewModel>

@* Dropdown body for the global search box. Injected by site.js as the user types.
   Results arrive already ordered (Pages first, then each data type), so grouping by
   Category yields section headers in that same order. *@
@if (Model.Count == 0)
{
    <div class="px-4 py-3 text-sm text-slate-400">No matches.</div>
}
else
{
    <div class="max-h-96 overflow-y-auto py-1">
        @foreach (var group in Model.GroupBy(result => result.Category))
        {
            <div class="px-4 pb-1 pt-2 text-[10px] font-semibold uppercase tracking-widest text-slate-500">
                @group.Key
            </div>
            <ul class="pb-1">
                @foreach (var result in group)
                {
                    <li>
                        <a href="@result.Url"
                           class="block truncate px-4 py-2 text-sm text-slate-200 transition hover:bg-white/5 hover:text-white">
                            @result.Title
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
}
