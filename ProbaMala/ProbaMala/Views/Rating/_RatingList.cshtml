@model List<ProbaMala.Models.ViewModels.RatingDetailsViewModel>

@{
    // Ownership info supplied by the controller: an Admin sees every control; a signed-in
    // user sees Edit/Delete only on ratings they authored. Anyone signed in can add one.
    var isAdmin = ViewData["IsAdmin"] as bool? ?? false;
    var currentProfileId = ViewData["CurrentProfileId"] as int?;
    var canAddRating = User.Identity?.IsAuthenticated ?? false;
    var listTitle = ViewData["RatingListTitle"] as string ?? "Ratings";
    // On the personal "Your ratings" page we keep the Edit/Delete controls always
    // visible (hover-only reveals nothing on touch devices); elsewhere they fade in on hover.
    var alwaysShowActions = ViewData["RatingActionsAlwaysVisible"] as bool? ?? false;
    var actionsVisibility = alwaysShowActions ? "" : "opacity-0 group-hover:opacity-100";
}

@* Section header with Add Rating button *@
<div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
    <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">@listTitle</span>
    @if (canAddRating)
    {
        <a asp-route="rating-create" class="flex items-center gap-1 text-xs font-semibold text-lime-400 transition hover:text-lime-300">
            <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
            </svg>
            Add rating
        </a>
    }
</div>

@* Column headers *@
<div class="flex items-center justify-between border-b border-slate-800/60 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-slate-600">
    <span>Player &amp; Match</span>
    <span>Rtg</span>
</div>

@if (!Model.Any())
{
    <div class="px-4 py-8 text-center text-sm text-slate-500">No ratings found.</div>
}
else
{
    @foreach (var rating in Model)
    {
        @* Score badge color *@
        var scoreBadgeClass = rating.Score switch
        {
            >= 9 => "bg-emerald-500/15 text-emerald-300",
            >= 7 => "bg-lime-500/15 text-lime-300",
            >= 5 => "bg-amber-500/15 text-amber-300",
            _    => "bg-rose-500/15 text-rose-300"
        };

        <div class="group cursor-pointer border-b border-slate-800/40 px-4 py-3 last:border-b-0 transition hover:bg-white/[0.03]"
             data-row-href="@Url.RouteUrl("rating-details", new { id = rating.Id })">

            @* Line 1: player name + comment on left, score badge + actions on right *@
            <div class="flex items-start gap-2">
                <span class="mt-1 h-4 w-1 shrink-0 rounded-full bg-lime-500 opacity-70"></span>
                <div class="min-w-0 flex-1">
                    <a asp-route="player-details" asp-route-id="@rating.PlayerId"
                       class="block truncate text-sm font-medium text-slate-100 transition hover:text-lime-400">@rating.PlayerName</a>
                    @if (!string.IsNullOrWhiteSpace(rating.Comment))
                    {
                        <span class="mt-0.5 block truncate text-xs text-slate-500">@rating.Comment</span>
                    }
                </div>
                <div class="flex shrink-0 items-center gap-1">
                    <span class="inline-flex h-7 w-7 items-center justify-center rounded-full text-xs font-bold @scoreBadgeClass">
                        @rating.Score
                    </span>
                    <div class="flex items-center gap-1 transition @actionsVisibility">
                        @if (isAdmin || (currentProfileId.HasValue && currentProfileId.Value == rating.UserId))
                        {
                        <a asp-route="rating-edit" asp-route-id="@rating.Id"
                           title="Edit"
                           class="rounded p-1 text-slate-400 transition hover:bg-slate-700 hover:text-slate-100">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" />
                            </svg>
                        </a>
                        <a asp-route="rating-delete" asp-route-id="@rating.Id"
                           title="Delete"
                           class="rounded p-1 text-slate-400 transition hover:bg-rose-500/10 hover:text-rose-400">
                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" />
                            </svg>
                        </a>
                        }
                    </div>
                </div>
            </div>

            @* Line 2: match info *@
            <div class="mt-1.5 pl-3">
                <a asp-route="match-details" asp-route-id="@rating.MatchId"
                   class="flex items-center gap-2 transition hover:opacity-80"
                   title="View match">
                    <span class="truncate text-xs text-slate-400">@rating.HomeTeamName</span>
                    <span class="shrink-0 rounded bg-slate-800 px-1.5 py-0.5 text-[0.65rem] font-bold tabular-nums text-slate-200">@rating.MatchScore</span>
                    <span class="truncate text-xs text-slate-400">@rating.AwayTeamName</span>
                </a>
            </div>
        </div>
    }
}
