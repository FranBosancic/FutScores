@model List<ProbaMala.Models.ViewModels.RatingDetailsViewModel>
@{
    ViewData["Title"] = "Your ratings";
}

<div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
    <div class="mb-4">
        <h1 class="text-lg font-semibold text-white">Your ratings</h1>
        <p class="mt-0.5 text-sm text-slate-500">Ratings you've submitted — edit or delete any of them with the controls on each row.</p>
    </div>

    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">
        <partial name="_RatingList" model="Model" />
    </div>
</div>
