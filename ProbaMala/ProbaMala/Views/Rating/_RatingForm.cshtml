@model RatingFormViewModel

@{
    var previewScore = Math.Clamp(Model.Score, 1, 10);
    var previewToneClass = previewScore switch
    {
        >= 9 => "border-emerald-400/20 bg-emerald-500/10 text-emerald-200",
        >= 7 => "border-lime-400/20 bg-lime-500/10 text-lime-200",
        >= 5 => "border-amber-400/20 bg-amber-500/10 text-amber-200",
        _ => "border-rose-400/20 bg-rose-500/10 text-rose-200"
    };

    var previewLabel = previewScore switch
    {
        >= 9 => "Standout display",
        >= 7 => "Strong performance",
        >= 5 => "Mixed return",
        _ => "Underwhelming night"
    };
}

<div asp-validation-summary="ModelOnly" class="mb-5 rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200 empty:hidden"></div>

<input asp-for="Id" type="hidden" />

<div class="space-y-6">

    @* Player / Match / User / live snapshot *@
    <div class="grid gap-6 lg:grid-cols-2">
        <div>
            <label asp-for="PlayerId" class="mb-2 block text-sm font-medium text-slate-200"></label>
            <partial name="_AutocompleteField" model='new AutocompleteFieldViewModel
            {
                Label = "Player",
                HiddenInputName = nameof(Model.PlayerId),
                HiddenInputId = Html.IdFor(model => model.PlayerId).ToString(),
                HiddenValue = Model.PlayerId,
                VisibleInputName = nameof(Model.PlayerLabel),
                VisibleInputId = Html.IdFor(model => model.PlayerLabel).ToString(),
                VisibleValue = Model.PlayerLabel,
                SearchUrl = Url.RouteUrl("rating-player-search") ?? string.Empty,
                Placeholder = "Search players by first or last name",
                EmptyStateText = "No players found."
            }' />
            <span asp-validation-for="PlayerId" class="mt-2 block text-sm text-rose-300"></span>
        </div>

        <div>
            <label asp-for="MatchId" class="mb-2 block text-sm font-medium text-slate-200"></label>
            <select asp-for="MatchId" asp-items="Model.MatchOptions" class="w-full rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2.5 text-sm text-slate-100 outline-none transition focus:border-lime-500/60 focus:bg-slate-800">
                <option value="">Select a match</option>
            </select>
            <span asp-validation-for="MatchId" class="mt-2 block text-sm text-rose-300"></span>
        </div>

        <div>
            <label asp-for="UserId" class="mb-2 block text-sm font-medium text-slate-200"></label>
            <select asp-for="UserId" asp-items="Model.UserOptions" class="w-full rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2.5 text-sm text-slate-100 outline-none transition focus:border-lime-500/60 focus:bg-slate-800">
                <option value="">Select a user</option>
            </select>
            <span asp-validation-for="UserId" class="mt-2 block text-sm text-rose-300"></span>
        </div>

        @* Live score snapshot *@
        <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-4">
            <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                    <div class="text-xs font-semibold uppercase tracking-widest text-slate-500">Score snapshot</div>
                    <div data-rating-score-label class="mt-2 text-sm font-semibold text-slate-100">@previewLabel</div>
                    <div class="mt-1 text-xs text-slate-500">Shape the tone before adding the review.</div>
                </div>
                <span data-rating-score-chip class="inline-flex h-12 min-w-[3rem] shrink-0 items-center justify-center rounded-lg border px-3 text-2xl font-bold tabular-nums @previewToneClass">@previewScore</span>
            </div>
        </div>
    </div>

    @* Score slider *@
    <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-4" data-rating-score-root>
        <div class="flex items-center justify-between gap-4">
            <label asp-for="Score" class="block text-sm font-medium text-slate-200"></label>
            <span class="rounded border border-slate-700 px-2 py-0.5 text-xs font-semibold uppercase tracking-widest text-slate-400">1 to 10 scale</span>
        </div>

        <div class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,1fr)_88px] lg:items-center">
            <input data-rating-score-range type="range" min="1" max="10" value="@previewScore" class="h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-800 accent-lime-500" />
            <input asp-for="Score" data-rating-score-input type="number" min="1" max="10" class="w-full rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2.5 text-center text-lg font-semibold text-slate-100 outline-none transition focus:border-lime-500/60 focus:bg-slate-800" />
        </div>

        <div class="mt-3 flex justify-between text-xs font-semibold uppercase tracking-widest text-slate-600">
            <span>Poor</span>
            <span>Average</span>
            <span>Elite</span>
        </div>
    </div>
    <span asp-validation-for="Score" class="-mt-3 block text-sm text-rose-300"></span>

    @* Written review *@
    <div>
        <div class="mb-2 flex items-center justify-between gap-4">
            <label asp-for="Comment" class="block text-sm font-medium text-slate-200"></label>
            <span class="text-xs font-semibold uppercase tracking-widest text-slate-500"><span data-rating-comment-count>@(Model.Comment?.Length ?? 0)</span>/400</span>
        </div>
        <textarea asp-for="Comment" data-rating-comment-input maxlength="400" rows="7" class="w-full rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2.5 text-sm text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-lime-500/60 focus:bg-slate-800" placeholder="Summarise the performance: decisive actions, mistakes, overall control, or standout moments."></textarea>
        <span asp-validation-for="Comment" class="mt-2 block text-sm text-rose-300"></span>
    </div>

    @* Rating guide *@
    <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-4">
        <div class="text-xs font-semibold uppercase tracking-widest text-slate-400">Rating guide</div>
        <p class="mt-1 text-xs text-slate-500">Keep the number readable against what actually happened.</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
            <div class="rounded-lg border border-emerald-400/20 bg-emerald-500/10 px-3 py-2 text-sm text-slate-300">
                <strong class="text-emerald-200">9–10</strong> · Match-defining, elite, clear MOTM level.
            </div>
            <div class="rounded-lg border border-lime-400/20 bg-lime-500/10 px-3 py-2 text-sm text-slate-300">
                <strong class="text-lime-200">7–8</strong> · Strong, visibly positive across phases.
            </div>
            <div class="rounded-lg border border-amber-400/20 bg-amber-500/10 px-3 py-2 text-sm text-slate-300">
                <strong class="text-amber-200">5–6</strong> · Mixed or stable, no decisive edge.
            </div>
            <div class="rounded-lg border border-rose-400/20 bg-rose-500/10 px-3 py-2 text-sm text-slate-300">
                <strong class="text-rose-200">1–4</strong> · Poor execution or little positive impact.
            </div>
        </div>
    </div>

</div>
