@model RatingDetailsViewModel

@{
    ViewData["Title"] = "Delete Rating";
    var scoreToneClass = Model.Score switch
    {
        >= 9 => "border-emerald-400/20 bg-emerald-500/10 text-emerald-200",
        >= 7 => "border-lime-400/20 bg-lime-500/10 text-lime-200",
        >= 5 => "border-amber-400/20 bg-amber-500/10 text-amber-200",
        _ => "border-rose-400/20 bg-rose-500/10 text-rose-200"
    };
}

<div class="mx-auto w-full max-w-3xl space-y-4 px-4 sm:px-6">

    <div class="overflow-hidden rounded-xl border border-rose-500/30 bg-[#0b0f1a]">

        @* Title bar *@
        <div class="flex items-center justify-between border-b border-rose-500/20 bg-rose-500/5 px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="h-4 w-1 shrink-0 rounded-full bg-rose-500 opacity-80"></span>
                <span class="text-sm font-semibold text-slate-100">Delete rating</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-500">
                <a asp-route="ratings-index" class="transition hover:text-slate-300">All ratings</a>
                <span>/</span>
                <a asp-route="rating-details" asp-route-id="@Model.Id" class="transition hover:text-slate-300">Details</a>
                <span>/</span>
                <span class="text-rose-300">Delete</span>
            </div>
        </div>

        @* Body *@
        <div class="px-4 py-5">
            <p class="mb-4 text-sm text-slate-400">
                You're about to delete <span class="font-semibold text-slate-100">rating #@Model.Id</span>. This permanently removes the selected rating from the database.
            </p>

            <div asp-validation-summary="ModelOnly" class="mb-4 rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200 empty:hidden"></div>

            @* Detail summary *@
            <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-4">
                <div class="grid gap-4 text-sm sm:grid-cols-2">
                    <div>
                        <div class="text-xs uppercase tracking-widest text-slate-500">Player</div>
                        <div class="mt-1 text-slate-200">@Model.PlayerName</div>
                    </div>
                    <div>
                        <div class="text-xs uppercase tracking-widest text-slate-500">Match</div>
                        <div class="mt-1 text-slate-200">@Model.MatchDescription</div>
                    </div>
                    <div>
                        <div class="text-xs uppercase tracking-widest text-slate-500">User</div>
                        <div class="mt-1 text-slate-200">@Model.UserName</div>
                    </div>
                    <div>
                        <div class="text-xs uppercase tracking-widest text-slate-500">Score</div>
                        <div class="mt-1 inline-flex rounded-full border px-3 py-1 font-semibold @scoreToneClass">@Model.Score</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Comment))
                {
                    <div class="mt-4 border-t border-slate-800 pt-4 text-sm text-slate-300">
                        @Model.Comment
                    </div>
                }
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-5 flex flex-wrap items-center gap-3 border-t border-slate-800/60 pt-5">
                @Html.AntiForgeryToken()
                <button type="submit" class="inline-flex items-center rounded-lg bg-rose-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-400">Delete rating</button>
                <a asp-route="rating-details" asp-route-id="@Model.Id" class="inline-flex items-center rounded-lg border border-slate-700 px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-slate-100">Cancel</a>
            </form>
        </div>
    </div>
</div>
