@model PlayerFormViewModel

@{
    ViewData["Title"] = "Create Player";
    ViewData["AiPlaceholder"] = "e.g. Add Erling Haaland, a forward from Norway born in 2000, to Manchester City.";
}

<div class="mx-auto w-full max-w-3xl space-y-4 px-4 sm:px-6">

    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

        @* Title bar *@
        <div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="h-4 w-1 shrink-0 rounded-full bg-lime-500 opacity-70"></span>
                <span class="text-sm font-semibold text-slate-100">Create a new player</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-500">
                <a asp-route="players-index" class="transition hover:text-slate-300">All players</a>
                <span>/</span>
                <span class="text-slate-400">Create</span>
            </div>
        </div>

        @* Body *@
        <div class="px-4 py-5">
            <p class="mb-5 text-sm text-slate-400">Add a player profile tied to a club, position, and nationality.</p>

            <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-rose-300 empty:hidden"></div>
            <partial name="_AiAssistBox" />

            <form asp-action="Create" method="post" class="space-y-6">
                @Html.AntiForgeryToken()
                <partial name="_PlayerForm" model="Model" />

                <div class="flex flex-wrap items-center gap-3 border-t border-slate-800/60 pt-5">
                    <button type="submit" class="inline-flex items-center rounded-lg bg-lime-500 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-lime-400">Save player</button>
                    <a asp-route="players-index" class="inline-flex items-center rounded-lg border border-slate-700 px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-slate-100">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
