@model PlayerFormViewModel

@{
    ViewData["Title"] = "Edit Player";
}

<div class="mx-auto w-full max-w-3xl space-y-4 px-4 sm:px-6">

    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

        @* Title bar *@
        <div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="h-4 w-1 shrink-0 rounded-full bg-lime-500 opacity-70"></span>
                <span class="text-sm font-semibold text-slate-100">Edit player</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-500">
                <a asp-route="players-index" class="transition hover:text-slate-300">All players</a>
                <span>/</span>
                <a asp-route="player-details" asp-route-id="@Model.Id" class="transition hover:text-slate-300">Details</a>
                <span>/</span>
                <span class="text-slate-400">Edit</span>
            </div>
        </div>

        @* Body *@
        <div class="px-4 py-5">
            <p class="mb-5 text-sm text-slate-400">Update the player profile and club context.</p>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-6">
                @Html.AntiForgeryToken()
                <partial name="_PlayerForm" model="Model" />

                <div class="flex flex-wrap items-center gap-3 border-t border-slate-800/60 pt-5">
                    <button type="submit" class="inline-flex items-center rounded-lg bg-lime-500 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-lime-400">Save changes</button>
                    <a asp-route="player-details" asp-route-id="@Model.Id" class="inline-flex items-center rounded-lg border border-slate-700 px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-slate-100">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    @* ── Images / photo ── *@
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">
        <div class="flex items-center gap-2 border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
            <span class="h-4 w-1 shrink-0 rounded-full bg-lime-500 opacity-70"></span>
            <span class="text-sm font-semibold text-slate-100">Player images</span>
        </div>

        <div class="space-y-4 px-4 py-5">
            <p class="text-sm text-slate-400">Upload one or more images. The image marked <span class="font-medium text-lime-400">photo</span> represents the player.</p>

            @* Dropzone target. autoDiscover is off — initialised explicitly in the script below. *@
            <form id="imageDropzone"
                  asp-controller="Player" asp-action="UploadImage" asp-route-id="@Model.Id"
                  enctype="multipart/form-data"
                  class="dropzone !min-h-[8rem] !rounded-lg !border !border-dashed !border-slate-700 !bg-slate-900/40">
            </form>

            <div id="imageList"></div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/dropzone@5.9.3/dist/min/dropzone.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/dropzone@5.9.3/dist/min/dropzone.min.js"></script>

    <script>
        Dropzone.autoDiscover = false;

        (function () {
            // Reuse the anti-forgery token rendered by the main edit form above.
            var token      = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var listUrl    = '@Url.Action("GetImages", "Player", new { id = Model.Id })';
            var deleteUrl  = '@Url.Action("DeleteImage", "Player")';
            var primaryUrl = '@Url.Action("SetPrimaryImage", "Player")';

            function loadImages() { $('#imageList').load(listUrl); }

            // Called from buttons rendered inside the _ImageList partial.
            window.deleteImage = function (id) {
                $.ajax({ url: deleteUrl, method: 'POST', data: { imageId: id },
                         headers: { 'RequestVerificationToken': token } }).done(loadImages);
            };
            window.setPrimaryImage = function (id) {
                $.ajax({ url: primaryUrl, method: 'POST', data: { imageId: id },
                         headers: { 'RequestVerificationToken': token } }).done(loadImages);
            };

            new Dropzone('#imageDropzone', {
                paramName: 'file',
                maxFilesize: 5,                  // MB
                maxFiles: 1,                     // one image per player
                acceptedFiles: 'image/*',
                addRemoveLinks: true,
                dictDefaultMessage: 'Drop an image here or click to upload',
                dictMaxFilesExceeded: 'Only one image is allowed. Delete the existing one first.',
                headers: { 'RequestVerificationToken': token },
                init: function () {
                    this.on('success', function (file) { this.removeFile(file); loadImages(); });
                }
            });

            loadImages();
        })();
    </script>
}
