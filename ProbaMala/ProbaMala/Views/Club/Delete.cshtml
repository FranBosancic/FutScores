@model ClubDetailsViewModel

@{
    ViewData["Title"] = "Delete Club";
}

<div class="mx-auto w-full max-w-3xl space-y-4 px-4 sm:px-6">

    <div class="overflow-hidden rounded-xl border border-rose-500/30 bg-[#0b0f1a]">

        @* Title bar *@
        <div class="flex items-center justify-between border-b border-rose-500/20 bg-rose-500/5 px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="h-4 w-1 shrink-0 rounded-full bg-rose-500 opacity-80"></span>
                <span class="text-sm font-semibold text-slate-100">Delete club</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-500">
                <a asp-route="clubs-index" class="transition hover:text-slate-300">All clubs</a>
                <span>/</span>
                <a asp-route="club-details" asp-route-id="@Model.Id" class="transition hover:text-slate-300">Details</a>
                <span>/</span>
                <span class="text-rose-300">Delete</span>
            </div>
        </div>

        @* Body *@
        <div class="px-4 py-5">
            <p class="mb-4 text-sm text-slate-400">
                You're about to delete <span class="font-semibold text-slate-100">@Model.Name</span>. This removes the club from the database only when no dependent players or matches still reference it.
            </p>

            <div asp-validation-summary="ModelOnly" class="mb-4 rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200 empty:hidden"></div>

            @* Detail summary *@
            <div class="grid gap-4 rounded-lg border border-slate-800 bg-slate-900/40 p-4 text-sm sm:grid-cols-2">
                <div>
                    <div class="text-xs uppercase tracking-widest text-slate-500">Club</div>
                    <div class="mt-1 text-slate-200">@Model.Name</div>
                </div>
                <div>
                    <div class="text-xs uppercase tracking-widest text-slate-500">League</div>
                    <div class="mt-1 text-slate-200">@Model.LeagueName</div>
                </div>
                <div>
                    <div class="text-xs uppercase tracking-widest text-slate-500">Players</div>
                    <div class="mt-1 text-slate-200">@Model.PlayerCount</div>
                </div>
                <div>
                    <div class="text-xs uppercase tracking-widest text-slate-500">Matches</div>
                    <div class="mt-1 text-slate-200">@Model.MatchCount</div>
                </div>
            </div>

            @if (!Model.CanDelete)
            {
                <div class="mt-4 rounded-lg border border-amber-500/20 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">
                    Delete is blocked because this club still has related players or scheduled matches. Remove or reassign those records first.
                </div>
            }

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-5 flex flex-wrap items-center gap-3 border-t border-slate-800/60 pt-5">
                @Html.AntiForgeryToken()
                <button type="submit" class="inline-flex items-center rounded-lg bg-rose-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-400 disabled:cursor-not-allowed disabled:opacity-50" @(Model.CanDelete ? null : "disabled")>Delete club</button>
                <a asp-route="club-details" asp-route-id="@Model.Id" class="inline-flex items-center rounded-lg border border-slate-700 px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-slate-100">Cancel</a>
            </form>
        </div>
    </div>
</div>
