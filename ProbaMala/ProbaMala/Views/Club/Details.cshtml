@using ProbaMala.Models.Entities
@model ProbaMala.Models.ViewModels.ClubDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="mx-auto w-full max-w-3xl space-y-4 px-4 sm:px-6">

    @* Header panel *@
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

        @* Title bar with lime accent and breadcrumb actions *@
        <div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="h-4 w-1 shrink-0 rounded-full bg-lime-500 opacity-70"></span>
                <span class="text-sm font-semibold text-slate-100">@Model.Name</span>
                <span class="mx-1 text-slate-600">/</span>
                <a asp-route="clubs-index" class="text-xs text-slate-400 transition hover:text-slate-200">All clubs</a>
            </div>
            <div class="flex items-center gap-2">
                <a asp-route="club-edit" asp-route-id="@Model.Id"
                   class="flex items-center gap-1 rounded px-2 py-1 text-xs text-slate-400 transition hover:bg-slate-700 hover:text-slate-100">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" />
                    </svg>
                    Edit
                </a>
                <a asp-route="club-delete" asp-route-id="@Model.Id"
                   class="flex items-center gap-1 rounded px-2 py-1 text-xs text-slate-400 transition hover:bg-rose-500/10 hover:text-rose-400">
                    <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" />
                    </svg>
                    Delete
                </a>
            </div>
        </div>

        @* Stat chips row *@
        <div class="flex flex-wrap items-center gap-3 px-4 py-4">
            @* Founded *@
            <div class="flex items-center gap-1.5 rounded-lg bg-slate-800/60 px-3 py-1.5">
                <span class="text-xs text-slate-500">Founded</span>
                <span class="text-sm font-semibold text-slate-100">@Model.FoundedDate.Year</span>
            </div>

            @* League *@
            <div class="flex items-center gap-1.5 rounded-lg bg-slate-800/60 px-3 py-1.5">
                <span class="text-xs text-slate-500">League</span>
                @if (Model.LeagueId != 0)
                {
                    <a asp-route="league-details" asp-route-id="@Model.LeagueId"
                       class="text-sm font-semibold text-lime-400 transition hover:text-lime-300">
                        @(Model.LeagueName ?? "—")
                    </a>
                }
                else
                {
                    <span class="text-sm font-semibold text-slate-100">—</span>
                }
            </div>

            @* Players *@
            <div class="flex items-center gap-1.5 rounded-lg bg-slate-800/60 px-3 py-1.5">
                <span class="text-xs text-slate-500">Players</span>
                <span class="text-sm font-semibold text-slate-100">@Model.PlayerCount</span>
            </div>

            @* Matches *@
            <div class="flex items-center gap-1.5 rounded-lg bg-slate-800/60 px-3 py-1.5">
                <span class="text-xs text-slate-500">Matches</span>
                <span class="text-sm font-semibold text-slate-100">@Model.MatchCount</span>
            </div>
        </div>
    </div>

    @* Squad panel *@
    @{
        var squadFilterUrl = Url.RouteUrl("club-squad-filter", new { id = Model.Id });
    }
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

        <div class="flex items-center justify-between gap-3 border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
            <span class="shrink-0 text-xs font-semibold uppercase tracking-widest text-slate-400">Squad</span>
            <div class="relative flex-1">
                <svg class="pointer-events-none absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-slate-500"
                     fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                </svg>
                <input type="search"
                       placeholder="Search squad…"
                       class="w-full rounded border border-slate-700/50 bg-slate-800/60 py-1 pl-8 pr-3 text-xs text-slate-100 outline-none transition placeholder:text-slate-600 focus:border-slate-600 focus:bg-slate-800"
                       data-live-filter-input
                       data-filter-url="@squadFilterUrl"
                       data-filter-target="squad-filter-results" />
            </div>
            <a asp-route="player-create" class="flex shrink-0 items-center gap-1 text-xs font-semibold text-lime-400 transition hover:text-lime-300">
                <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                </svg>
                Add player
            </a>
        </div>

        <div id="squad-filter-results">
            <partial name="_ClubSquad" model="Model.Players ?? new List<ProbaMala.Models.ViewModels.PlayerDetailsViewModel>()" />
        </div>
    </div>

</div>
