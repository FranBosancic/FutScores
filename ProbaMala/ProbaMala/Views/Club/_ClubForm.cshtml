@model ClubFormViewModel

<div asp-validation-summary="ModelOnly" class="mb-5 rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200"></div>

<input asp-for="Id" type="hidden" />

<div class="grid gap-6 lg:grid-cols-2">
    <div class="lg:col-span-2">
        <label asp-for="Name" class="mb-2 block text-sm font-medium text-slate-200"></label>
        <input asp-for="Name" class="w-full rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2.5 text-sm text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-lime-500/60 focus:bg-slate-800" />
        <span asp-validation-for="Name" class="mt-2 block text-sm text-rose-300"></span>
    </div>

    <div>
        <label asp-for="LeagueId" class="mb-2 block text-sm font-medium text-slate-200"></label>
        <select asp-for="LeagueId" asp-items="Model.LeagueOptions" class="w-full rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2.5 text-sm text-slate-100 outline-none transition focus:border-lime-500/60 focus:bg-slate-800">
            <option value="">Select a league</option>
        </select>
        <span asp-validation-for="LeagueId" class="mt-2 block text-sm text-rose-300"></span>
    </div>

    <div>
        <label asp-for="FoundedDate" class="mb-2 block text-sm font-medium text-slate-200"></label>
        <partial name="_DateTimePicker" model='new DateTimePickerViewModel
        {
            InputName = nameof(Model.FoundedDate),
            InputId = Html.IdFor(model => model.FoundedDate).ToString(),
            Value = Model.FoundedDate,
            Placeholder = "Choose founded date",
            EnableTime = false,
            MinuteIncrement = 5
        }' />
        <p class="mt-2 text-xs text-slate-500">This custom control adapts its date format to the browser language.</p>
        <span asp-validation-for="FoundedDate" class="mt-2 block text-sm text-rose-300"></span>
    </div>
</div>