@model List<ProbaMala.Models.ViewModels.ClubDetailsViewModel>
@{
    // When viewing a single league's clubs, the league column is redundant
    // (it's the same for every row), so we drop it and narrow the grid.
    var leagueScoped = (ViewData["LeagueId"] as int?).HasValue;
    // Mobile collapses to a single Club column (the other facts fold into a subline);
    // the full table grid returns at sm+.
    var gridCols = leagueScoped
        ? "grid-cols-[1fr] sm:grid-cols-[1fr_5rem_5rem_5rem_4rem]"
        : "grid-cols-[1fr] sm:grid-cols-[1fr_8rem_5rem_5rem_5rem_4rem]";
}

@* Section header with Add Club button *@
<div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
    <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Clubs</span>
    @if (User.IsInRole("Admin"))
    {
        <a asp-route="club-create" class="flex items-center gap-1 text-xs font-semibold text-lime-400 transition hover:text-lime-300">
            <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
            </svg>
            Add club
        </a>
    }
</div>

@* Column headers — secondary columns hide on mobile (folded into each row's subline) *@
<div class="grid @gridCols border-b border-slate-800/60 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-slate-600">
    <span>Club</span>
    @if (!leagueScoped)
    {
        <span class="hidden sm:block">League</span>
    }
    <span class="hidden text-center sm:block">Founded</span>
    <span class="hidden text-center sm:block">Players</span>
    <span class="hidden text-center sm:block">Matches</span>
    <span class="hidden sm:block"></span>
</div>

@if (!Model.Any())
{
    <div class="px-4 py-8 text-center text-sm text-slate-500">No clubs found.</div>
}
else
{
    @foreach (var club in Model)
    {
        <div class="group grid cursor-pointer @gridCols items-center border-b border-slate-800/40 px-4 py-3 last:border-b-0 transition hover:bg-white/[0.03]"
             data-row-href="@Url.RouteUrl("club-details", new { id = club.Id })">
            @* Club name with banner thumbnail (falls back to an initial).
               On mobile, league/founded/counts fold into a subline beneath the name. *@
            <div class="flex min-w-0 items-center gap-2.5">
                @if (!string.IsNullOrEmpty(club.BannerUrl))
                {
                    <img src="@club.BannerUrl" alt="@club.Name" class="h-8 w-8 shrink-0 rounded object-cover" />
                }
                else
                {
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded bg-slate-800 text-xs font-semibold text-slate-400">@club.Name.Substring(0, 1)</span>
                }
                <div class="min-w-0">
                    <a asp-route="club-details" asp-route-id="@club.Id"
                       class="block truncate text-sm font-medium text-slate-100 hover:text-lime-400 transition">
                        @club.Name
                    </a>
                    <span class="mt-0.5 block truncate text-xs text-slate-500 sm:hidden">@(leagueScoped ? "" : (club.LeagueName ?? "—") + " · ")est. @club.FoundedDate.Year · @club.PlayerCount players · @club.MatchCount matches</span>
                </div>
            </div>

            @* League name (sm+) — hidden when already scoped to a single league *@
            @if (!leagueScoped)
            {
                <span class="hidden truncate text-sm text-slate-400 sm:block">@(club.LeagueName ?? "—")</span>
            }

            @* Founded year (sm+) *@
            <span class="hidden text-center text-sm text-slate-400 sm:block">@club.FoundedDate.Year</span>

            @* Players count (sm+) *@
            <span class="hidden text-center text-sm text-slate-400 sm:block">@club.PlayerCount</span>

            @* Matches count (sm+) *@
            <span class="hidden text-center text-sm text-slate-400 sm:block">@club.MatchCount</span>

            @* Edit / Delete actions — admin only, fade in on row hover (sm+) *@
            <div class="hidden items-center justify-end gap-1 opacity-0 transition group-hover:opacity-100 sm:flex">
                @if (User.IsInRole("Admin"))
                {
                <a asp-route="club-edit" asp-route-id="@club.Id"
                   title="Edit"
                   class="rounded p-1 text-slate-400 transition hover:bg-slate-700 hover:text-slate-100">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" />
                    </svg>
                </a>
                <a asp-route="club-delete" asp-route-id="@club.Id"
                   title="Delete"
                   class="rounded p-1 text-slate-400 transition hover:bg-rose-500/10 hover:text-rose-400">
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" />
                    </svg>
                </a>
                }
            </div>
        </div>
    }
}
