@model ProbaMala.Models.ViewModels.MatchDetailsViewModel
@{
    ViewData["Title"] = $"{Model.HomeTeamName} vs {Model.AwayTeamName}";

    var statusColor = Model.StatusTone switch
    {
        "live"     => "text-lime-400",
        "finished" => "text-slate-500",
        _          => "text-slate-400"
    };
}

<div class="mx-auto w-full max-w-3xl space-y-4 px-4 sm:px-6">

    @* Header panel *@
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

        @* Title bar: league + date, breadcrumb actions *@
        <div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="h-4 w-1 shrink-0 rounded-full bg-lime-500 opacity-70"></span>
                <a asp-route="league-details" asp-route-id="@Model.LeagueId"
                   class="text-xs font-semibold text-lime-400 transition hover:text-lime-300">
                    @Model.LeagueName
                </a>
                <span class="text-slate-600">·</span>
                <span class="text-xs text-slate-400">@Model.KickoffLabel</span>
                <span class="text-slate-600">·</span>
                <span class="text-xs font-medium @statusColor">@Model.StatusLabel</span>
            </div>
            <div class="flex items-center gap-2">
                <a asp-route="match-edit" asp-route-id="@Model.Id"
                   class="flex items-center gap-1 rounded px-2 py-1 text-xs text-slate-400 transition hover:bg-slate-700 hover:text-slate-100">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" />
                    </svg>
                    Edit
                </a>
                <a asp-route="match-delete" asp-route-id="@Model.Id"
                   class="flex items-center gap-1 rounded px-2 py-1 text-xs text-slate-400 transition hover:bg-rose-500/10 hover:text-rose-400">
                    <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" />
                    </svg>
                    Delete
                </a>
            </div>
        </div>

        @* Big score display: home | X – Y | away *@
        <div class="flex items-center justify-center gap-4 px-6 py-8">
            @* Home team *@
            <div class="flex flex-1 justify-end">
                <a asp-route="club-details" asp-route-id="@Model.HomeTeamId"
                   class="text-xl font-bold text-slate-100 transition hover:text-lime-400 text-right">
                    @Model.HomeTeamName
                </a>
            </div>

            @* Score badge *@
            <div class="flex shrink-0 flex-col items-center gap-1">
                <span class="inline-flex items-center rounded-lg bg-slate-800 px-5 py-2 text-2xl font-extrabold tabular-nums tracking-tight text-slate-100">
                    @Model.HomeGoals&nbsp;–&nbsp;@Model.AwayGoals
                </span>
            </div>

            @* Away team *@
            <div class="flex flex-1 justify-start">
                <a asp-route="club-details" asp-route-id="@Model.AwayTeamId"
                   class="text-xl font-bold text-slate-100 transition hover:text-lime-400 text-left">
                    @Model.AwayTeamName
                </a>
            </div>
        </div>

        @* Info chips row *@
        <div class="flex flex-wrap items-center gap-3 border-t border-slate-800/60 px-4 py-4">
            <div class="flex items-center gap-1.5 rounded-lg bg-slate-800/60 px-3 py-1.5">
                <span class="text-xs text-slate-500">League</span>
                <a asp-route="league-details" asp-route-id="@Model.LeagueId"
                   class="text-sm font-semibold text-lime-400 transition hover:text-lime-300">
                    @Model.LeagueName
                </a>
            </div>
            <div class="flex items-center gap-1.5 rounded-lg bg-slate-800/60 px-3 py-1.5">
                <span class="text-xs text-slate-500">Date</span>
                <span class="text-sm font-semibold text-slate-100">@Model.KickoffLabel</span>
            </div>
            <div class="flex items-center gap-1.5 rounded-lg bg-slate-800/60 px-3 py-1.5">
                <span class="text-xs text-slate-500">Status</span>
                <span class="text-sm font-semibold @statusColor">@Model.StatusLabel</span>
            </div>
            <div class="flex items-center gap-1.5 rounded-lg bg-slate-800/60 px-3 py-1.5">
                <span class="text-xs text-slate-500">Ratings</span>
                <span class="text-sm font-semibold text-slate-100">@Model.RatingCount</span>
            </div>
        </div>
    </div>

    @* Player ratings panel *@
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">
        <div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
            <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Player ratings</span>
            <a asp-route="rating-create" class="flex items-center gap-1 text-xs font-semibold text-lime-400 transition hover:text-lime-300">
                <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                </svg>
                Add rating
            </a>
        </div>
        @{ ViewData["RatingHide"] = "match"; }
        <partial name="_RatingMiniList" model="Model.Ratings" />
    </div>

</div>
