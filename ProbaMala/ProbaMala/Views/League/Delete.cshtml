@model LeagueDetailsViewModel

@{
    ViewData["Title"] = "Delete League";
}

<div class="mx-auto w-full max-w-3xl space-y-4 px-4 sm:px-6">

    <div class="overflow-hidden rounded-xl border border-rose-500/30 bg-[#0b0f1a]">

        @* Title bar *@
        <div class="flex items-center justify-between border-b border-rose-500/20 bg-rose-500/5 px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="h-4 w-1 shrink-0 rounded-full bg-rose-500 opacity-80"></span>
                <span class="text-sm font-semibold text-slate-100">Delete league</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-500">
                <a asp-route="leagues-index" class="transition hover:text-slate-300">All leagues</a>
                <span>/</span>
                <a asp-route="league-details" asp-route-id="@Model.Id" class="transition hover:text-slate-300">Details</a>
                <span>/</span>
                <span class="text-rose-300">Delete</span>
            </div>
        </div>

        @* Body *@
        <div class="px-4 py-5">
            <p class="mb-4 text-sm text-slate-400">
                You're about to delete <span class="font-semibold text-slate-100">@Model.Name</span>. This removes the league from the database.
            </p>

            <div asp-validation-summary="ModelOnly" class="mb-4 rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200 empty:hidden"></div>

            @* Detail summary *@
            <div class="grid gap-4 rounded-lg border border-slate-800 bg-slate-900/40 p-4 text-sm sm:grid-cols-3">
                <div>
                    <div class="text-xs uppercase tracking-widest text-slate-500">League</div>
                    <div class="mt-1 text-slate-200">@Model.Name</div>
                </div>
                <div>
                    <div class="text-xs uppercase tracking-widest text-slate-500">Clubs</div>
                    <div class="mt-1 text-slate-200">@Model.ClubCount</div>
                </div>
                <div>
                    <div class="text-xs uppercase tracking-widest text-slate-500">Matches</div>
                    <div class="mt-1 text-slate-200">@Model.MatchCount</div>
                </div>
            </div>

            <div class="mt-4 rounded-lg border border-amber-500/20 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">
                Deleting this league will also cascade into related clubs and matches. Because clubs cascade to players and ratings, this action can remove a large part of the connected data graph.
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-5 flex flex-wrap items-center gap-3 border-t border-slate-800/60 pt-5">
                @Html.AntiForgeryToken()
                <button type="submit" class="inline-flex items-center rounded-lg bg-rose-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-400">Delete league</button>
                <a asp-route="league-details" asp-route-id="@Model.Id" class="inline-flex items-center rounded-lg border border-slate-700 px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-slate-100">Cancel</a>
            </form>
        </div>
    </div>
</div>
