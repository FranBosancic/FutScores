@model LeagueDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="mx-auto w-full max-w-3xl space-y-4 px-4 sm:px-6">

    @* ══════════════════════════════════════════════
       LEAGUE HEADER
       ══════════════════════════════════════════════ *@
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

        @* Title bar *@
        <div class="flex items-center justify-between border-b border-slate-800 px-4 py-3">
            <div class="flex items-center gap-2.5">
                <span class="h-5 w-1.5 rounded-full bg-lime-500"></span>
                <h1 class="text-base font-semibold text-white">@Model.Name</h1>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-500">
                <a asp-route="leagues-index" class="transition hover:text-slate-300">All leagues</a>
                @if (User.IsInRole("Admin"))
                {
                    <span>/</span>
                    <a asp-route="league-edit" asp-route-id="@Model.Id" class="transition hover:text-slate-300">Edit</a>
                    <span>/</span>
                    <a asp-route="league-delete" asp-route-id="@Model.Id" class="text-rose-600 transition hover:text-rose-400">Delete</a>
                }
            </div>
        </div>

        @* Stat chips *@
        <div class="flex divide-x divide-slate-800">
            <div class="flex flex-1 flex-col items-center py-4 text-center">
                <span class="text-2xl font-bold tabular-nums text-white">@Model.ClubCount</span>
                <span class="mt-0.5 text-xs uppercase tracking-widest text-slate-500">Clubs</span>
            </div>
            <div class="flex flex-1 flex-col items-center py-4 text-center">
                <span class="text-2xl font-bold tabular-nums text-white">@Model.MatchCount</span>
                <span class="mt-0.5 text-xs uppercase tracking-widest text-slate-500">Matches</span>
            </div>
        </div>
    </div>

    @* ══════════════════════════════════════════════
       CLUBS TABLE
       ══════════════════════════════════════════════ *@
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

        <div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
            <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Clubs</span>
            <a href="/clubs?leagueId=@Model.Id" class="text-xs text-lime-400 transition hover:text-lime-300">View all</a>
        </div>

        @if (Model.Clubs == null || !Model.Clubs.Any())
        {
            <div class="py-10 text-center text-sm text-slate-600">No clubs in this league yet.</div>
        }
        else
        {
            @* Column labels *@
            <div class="grid grid-cols-[1fr_5rem_5rem_5rem] border-b border-slate-800/60 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-slate-600">
                <span>Club</span>
                <span class="text-right">Founded</span>
                <span class="text-right">Players</span>
                <span class="text-right">Matches</span>
            </div>

            @foreach (var club in Model.Clubs!)
            {
                <div class="grid cursor-pointer grid-cols-[1fr_5rem_5rem_5rem] items-center border-b border-slate-800/40 px-4 py-3 last:border-b-0 transition hover:bg-white/[0.03]"
                     data-row-href="/clubs/@club.Id">
                    <div class="flex min-w-0 items-center gap-2.5">
                        @if (!string.IsNullOrEmpty(club.BannerUrl))
                        {
                            <img src="@club.BannerUrl" alt="@club.Name" class="h-8 w-8 shrink-0 rounded object-cover" />
                        }
                        else
                        {
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded bg-slate-800 text-xs font-semibold text-slate-400">@club.Name.Substring(0, 1)</span>
                        }
                        <a href="/clubs/@club.Id" class="truncate font-medium text-slate-100 transition hover:text-white">
                            @club.Name
                        </a>
                    </div>
                    <span class="text-right text-sm tabular-nums text-slate-500">@club.FoundedDate.Year</span>
                    <span class="text-right text-sm tabular-nums text-slate-400">@club.PlayerCount</span>
                    <span class="text-right text-sm tabular-nums text-slate-400">@club.MatchCount</span>
                </div>
            }
        }
    </div>

    @* ══════════════════════════════════════════════
       MATCHES TABLE  (Flashscore-style rows)
       ══════════════════════════════════════════════ *@
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

        <div class="flex items-center justify-between border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
            <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Matches</span>
            <a href="/matches?leagueId=@Model.Id" class="text-xs text-lime-400 transition hover:text-lime-300">View all</a>
        </div>

        @if (Model.Matches == null || !Model.Matches.Any())
        {
            <div class="py-10 text-center text-sm text-slate-600">No matches in this league yet.</div>
        }
        else
        {
            @foreach (var match in Model.Matches!)
            {
                var isUpcoming = match.StatusTone == "upcoming";
                var statusClass = isUpcoming ? "text-sky-400" : "text-slate-500";

                <a href="/matches/@match.Id"
                   class="grid grid-cols-[5rem_1fr_auto_1fr_3rem] items-center gap-2 border-b border-slate-800/40 px-4 py-3 last:border-b-0 transition hover:bg-white/[0.03]">

                    @* Date + status stacked *@
                    <div class="flex flex-col leading-tight">
                        <span class="text-xs tabular-nums text-slate-500">@match.Date.ToString("dd MMM yyyy")</span>
                        <span class="mt-0.5 text-xs font-medium @statusClass">@match.StatusLabel</span>
                    </div>

                    @* Home team — right-aligned toward score *@
                    <span class="truncate text-right text-sm font-medium text-slate-100">@match.HomeTeamName</span>

                    @* Score — centred badge *@
                    <span class="shrink-0 rounded bg-slate-800 px-2.5 py-1 text-sm font-bold tabular-nums text-white">
                        @match.HomeGoals – @match.AwayGoals
                    </span>

                    @* Away team — left-aligned from score *@
                    <span class="truncate text-sm font-medium text-slate-100">@match.AwayTeamName</span>

                    @* Rating count — right edge *@
                    @if (match.RatingCount > 0)
                    {
                        <span class="text-right text-xs font-medium text-lime-500">@match.RatingCount ★</span>
                    }
                    else
                    {
                        <span></span>
                    }
                </a>
            }
        }
    </div>

</div>
