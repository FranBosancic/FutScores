@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="mx-auto w-full max-w-md px-4 sm:px-6">
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f1a]">

        @* Title bar *@
        <div class="flex items-center gap-2 border-b border-slate-800 bg-slate-800/40 px-4 py-2.5">
            <span class="h-4 w-1 shrink-0 rounded-full bg-rose-500 opacity-80"></span>
            <span class="text-sm font-semibold text-slate-100">Access denied</span>
        </div>

        @* Body *@
        <div class="px-4 py-6">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-rose-500/10 text-rose-400">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
            </div>
            <p class="text-sm text-slate-300">You don't have permission to perform this action.</p>
            <p class="mt-1 text-sm text-slate-500">Creating, editing and deleting content is restricted to administrators.</p>

            <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-slate-800/60 pt-5">
                <a asp-route="home-index"
                   class="inline-flex items-center rounded-lg bg-lime-500 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-lime-400">
                    Back to dashboard
                </a>
            </div>
        </div>
    </div>
</div>
